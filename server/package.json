{
  "name": "rutatech-server",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de RutaTech (Express + Prisma)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:setup": "prisma generate && prisma db push && node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:use-postgres": "node scripts/switch-provider.js postgresql",
    "db:use-sqlite": "node scripts/switch-provider.js sqlite",
    "test": "node --test test/*.test.js",
    "db:deploy": "prisma generate && prisma db push && node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.1.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "zod": "^4.6.7"
  }
}
