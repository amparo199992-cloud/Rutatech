# Copia este archivo como .env y ajusta los valores.

# Entorno: development | production
NODE_ENV=development
PORT=4000

# Base de datos. SQLite local por defecto (se crea el archivo automáticamente).
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL (producción): primero ejecuta `npm run db:use-postgres`
# DATABASE_URL="postgresql://usuario:clave@host:5432/rutatech"

# Secreto para firmar los tokens de sesión. OBLIGATORIO en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"

# URL pública del frontend (se usa en los enlaces de recuperación de contraseña)
CLIENT_URL="http://localhost:5173"
# URL pública del sitio (sitemap.xml). En despliegue de un solo servicio = CLIENT_URL
SITE_URL="http://localhost:5173"

# Solo si el frontend vive en OTRO dominio (p. ej. Vercel + Render):
# CORS_ORIGIN="https://rutatech.vercel.app"
# COOKIE_SAMESITE="none"

# Zona horaria para calcular la racha diaria
APP_TIMEZONE="America/Bogota"

# Cuenta administradora que crea el seed
ADMIN_EMAIL="admin@rutatech.local"
ADMIN_PASSWORD="CambiaEsto123"
ADMIN_NAME="Administración RutaTech"

# Correo para recuperación de contraseña (opcional en desarrollo:
# si no se configura, el enlace se imprime en la consola del servidor)
# Opción recomendada en la nube: Resend (https://resend.com), envía por HTTPS.
# RESEND_API_KEY="re_..."
# Opción alternativa: SMTP
# SMTP_HOST="smtp.tu-proveedor.com"
# SMTP_PORT=587
# SMTP_USER="usuario"
# SMTP_PASS="clave"
# MAIL_FROM="RutaTech <no-responder@tudominio.com>"
